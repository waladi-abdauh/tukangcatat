# NEXT.JS CORE
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GOOGLE GEMINI AI API
GEMINI_API_KEY=your-gemini-api-key
# (Opsional) Override model AI. Default gemini-3.6-flash — hasil pengukuran
# konsistensi kategori: 15/16 vs flash-lite 12/16, dan flash-lite salah terus
# pada "nasi goreng" (Dapur). Turunkan ke gemini-3.5-flash-lite hanya kalau
# biaya jadi prioritas dan akurasi kategori tidak masalah.
# GEMINI_MODEL=gemini-3.6-flash

# WHATSAPP API GATEWAY - pilih salah satu: fonnte | wablas | meta-cloud
WA_GATEWAY=fonnte

# Pengaman anti-blokir (semua opsional — ada default yang aman).
# Naikkan hanya setelah menaikkan kuota paket Wablas; gateway yang kehabisan
# kuota diblokir provider, bukan oleh kode kita.
# Catatan: nilai di bawah ini DIBACA per proses. Jalankan PM2 dengan
# instances: 1 (ecosystem.config.js) atau hitungan ini akan terlipat ganda.
# GLOBAL_DAILY_OUTBOUND_CAP=500    # pesan keluar/user/hari, lintas semua user
# GLOBAL_HOURLY_OUTBOUND_CAP=60    # pesan keluar/user/jam
# WA_QUIET_HOURS_START=22          # WIB — jam tenang mulai (WIB 22:00)
# WA_QUIET_HOURS_END=6             # WIB — jam tenang selesai (WIB 06:00)
# WA_WARMUP_MINUTES=60             # pakai gap lambat selama N menit pertama
# WA_WARMUP_SEND_GAP_MS=8000       # jeda saat warm-up (default 8 detik)
# WA_WARMUP_HOURLY_CAP=10           # pesan/jam saat warm-up
# WA_CIRCUIT_FAIL_THRESHOLD=3      # kegagalan beruntun sebelum jeda
# WA_CIRCUIT_BASE_PAUSE_MINUTES=10 # jeda pertama, lalu digandakan
# WA_CIRCUIT_MAX_PAUSE_MINUTES=40  # plafon jeda
# WA_GATEWAY_TIMEOUT_MS=20000      # timeout satu panggilan HTTP ke gateway

# Kredensial DIPISAH per gateway — pindah cukup ganti WA_GATEWAY di atas, tanpa
# downtime dan tanpa risiko salah paste token saat cutover.

# --- Fonnte ---
# Header Authorization = token polos (tanpa "Bearer"), body multipart FormData.
WA_FONNTE_TOKEN=your-fonnte-token

# --- Wablas ---
# Header Authorization = {token}.{secret_key} (tanpa "Bearer").
# WAJIB pakai subdomain akun dari dashboard Wablas. Domain generik wablas.com
# membalas 403 "API access is not allowed on this server".
WA_WABLAS_TOKEN=your-wablas-token
WA_WABLAS_SECRET=your-wablas-secret-key
WA_WABLAS_ENDPOINT=https://<subdomain>.wablas.com

# Nomor device yang mengirim webhook (allowlist di app). Sama untuk dua
# gateway karena nomornya satu: pada Wablas ini isi field "sender"; pada
# Fonnte field "device".
WA_DEVICE_NUMBER=628xxxxxxxxxx

# Secret webhook: tempel sebagai ?key=... pada Webhook URL di dashboard device.
# Wablas tidak menyediakan signature/HMAC, jadi token ini satu-satunya auth —
# pilih string acak panjang (openssl rand -hex 32).
WA_WEBHOOK_SECRET_TOKEN=your-random-secret-string

# Batas harian (opsional, isi bila mau override).
# FREE_DAILY_TRANSACTION_LIMIT=5   # catatan via WA/hari, akun gratis (default 5)
# PRO_DAILY_TRANSACTION_LIMIT=20
# FREE_DAILY_AI_PARSE_LIMIT=10     # pemanggilan Gemini/hari, akun gratis
# PRO_DAILY_AI_PARSE_LIMIT=60

# Pemeriksaan kesehatan device: jalankan /api/cron/gateway-health tiap 15
# menit dengan header Authorization: Bearer CRON_SECRET. Route ini melapor
# status device dan mengaktifkan kill switch otomatis kalau gateway banned.

# MIDTRANS PAYMENT GATEWAY
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxx
MIDTRANS_IS_PRODUCTION=false

# MAGIC LINK JWT SECRET - generate dengan: openssl rand -hex 32
JWT_SECRET_KEY=your-ultra-secure-jwt-secret-key

# CRON JOB SECRET - dipakai header Authorization: Bearer ... oleh /api/cron/*
# (Vercel Cron otomatis mengirim nilai ini dari env proyek). generate: openssl rand -hex 32
# CRON_SECRET=your-cron-secret

# NOMOR UJI (DEV ONLY) - dipakai scripts/seed/dummy.mts, verify/budget-periods.mts,
# dan verify/prime-bot.mts. Jangan diisi nomor bot (WA_DEVICE_NUMBER): script
# dummy.mts menghapus seluruh transaksi & budget nomor ini tiap dijalankan.
# DEV_TEST_PHONE=628xxxxxxxxxx

# WEB PUSH VAPID (notifikasi pengingat nyatet) - generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key